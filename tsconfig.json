{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    // Shared base only: each package extends this and lists its own `include`,
    // so the root must not compile the repo on its own.
    "files": [],
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}
