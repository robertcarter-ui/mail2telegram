{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "singleQuote": true,
    "semi": true,
    "arrowParens": "avoid",
    "printWidth": 120,
    "trailingComma": "all",
    "ignorePatterns": [
        "dist/**",
        "build/**",
        ".wrangler/**",
        "node_modules/**",
        "**/*.json",
        "**/*.jsonc",
        "**/*.yaml",
        "**/*.yml",
        "**/*.md"
    ]
}
